{
  "name": "datamosh-demo",
  "description": "Inter-frame decode loop in WebGL: previous frame warped by motion vectors plus residual, applied to a torus knot.",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "vite --host localhost"
  },
  "dependencies": {
    "postprocessing": "^6.36.7",
    "three": "^0.173.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.173.0",
    "typescript": "^5",
    "vite": "^8.2.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
