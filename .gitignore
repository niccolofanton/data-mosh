# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# playwright mcp artifacts
.playwright-mcp/
.perf-audit/

# scratch space for the Codrops editorial research (sitemaps, article index,
# per-article analyses). The deliverable it produced is committed under docs/;
# everything under here is intermediate.
full-project/archive/codrops-research/

# rendered from docs/CODROPS-ARTICLE.md; the Markdown is the source of truth
**/*.pdf

# Intermediate canvas captures: 200 MB of VP9 that encode.sh turns into
# article/html/video/*.mp4, which is what the article actually ships.
article/html/record/raw/

# Generated from article/html by article/build-submission.py.
article/submission/

# --- Local working material, deliberately not shared ---------------------
# The repo handed to Codrops is: full-project/, demo/, article/, README, LICENSE.
# Everything below is authoring scaffolding that would only add noise.

# The r3f original, superseded by demo/ (the vanilla rewrite the article uses).
demo-react/

# Screenshots taken while drafting the figures.
/*.png
# ...except the ones the demo itself ships.
!full-project/public/*.png

# Editorial scratch: shot dump and review notes.
/shots.json
/REVIEW-CODROPS.md

# The article and everything that produced it: the prose, the figures, the
# clips the published page ships, the narration, the in-page prose editor,
# and the Playwright capture rig with its 195 MB of intermediate VP9. Codrops
# receives the article through their own editorial pipeline, not through this
# repo, so none of it belongs in what is shared with them.
article/

# Vite's dependency cache, when a dev server is run from the root.
.vite/
