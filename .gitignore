# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp artifacts
.playwright-mcp/
.perf-audit/

# scratch space for the Codrops editorial research (sitemaps, article index,
# per-article analyses). The two deliverables it produces are committed under
# docs/; everything under here is intermediate.
.codrops-research/

# rendered from docs/CODROPS-ARTICLE.md; the Markdown is the source of truth
docs/*.pdf
